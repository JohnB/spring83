
<a href="#pg0" name="pg0"></a>
<!-- game0 start -->
<div class="playing-surface">
  <div class="board-and-player">
    <div class="board">
      <%= for y <- (0..19), x <- (0..19) do %>
        <% index = board_position_to_internal_poard_index(x, y) |> IO.inspect(label: "WTF") %>
        <div
          class="board-cell"
          id={"cell-#{index}"}
          onClick={"obc(#{index})"}
          onMouseOver={"ombin(#{index})"}
          onMouseOut={"ombout(#{index})"}
        >
        </div>
      <% end %>
    </div>
    <div class="replay-controls">
      <map name="map0">
        <area
          coords="1,1,23,19"
          title="to start"
          href="javascript:void(0)"
          onclick="GoStart(0); return false;"
        />
        <area
          coords="24,1,46,19"
          title="back 3"
          href="javascript:void(0)"
          onclick="Back3(0); return false;"
        />
        <area
          coords="47,1,69,19"
          title="back 1"
          href="javascript:void(0)"
          onclick="Back(0); return false;"
        />
        <area
          coords="70,1,92,19"
          title="forward 1"
          href="javascript:void(0)"
          onclick="Forward(0); return false;"
        />
        <area
          coords="93,1,115,19"
          title="forward 3"
          href="javascript:void(0)"
          onclick="Forward3(0); return false;"
        />
        <area
          coords="116,1,138,19"
          title="to end"
          href="javascript:void(0)"
          onclick="GoEnd(0); return false;"
        />
        <area
          coords="139,1,161,19"
          title="stop any playback"
          href="javascript:void(0)"
          onclick="stopAnyPlayback(0); return false;"
        />
        <area
          coords="162,1,184,19"
          title="autoplay"
          href="javascript:void(0)"
          onclick="Astart(0); return false;"
        />
      </map>
      <img src="images/p3condb.gif" border="0" usemap="#map0" height="18" width="183" />
    </div>
  </div>
  <div class="controls">
    <div class="flippers">
      <img
        src="images/flipdiagonal.gif"
        title="flip top right to bottom left"
        onclick="pieceFlipDiag()"
      />
      <img
        src="images/flipHorizontal.jpg"
        title="flip side to side"
        onclick="pieceFlipHorz()"
      />
      <img
        src="images/flipvertical.gif"
        title="flip top to bottom"
        onclick="pieceFlipVert()"
      />
      <button onclick="passYourTurn()">
        PASS
      </button>
    </div>
    <div id="bluePosition">
      <div>
      <span id="BLUEscore" class="score" >
        0
      </span>
        <span style={"BACKGROUND-COLOR: #{"LightBlue"};"}>
        playerFullname
        </span>
      </div>
      <div class="piece-set">
        <%= for piece <- ~w(a b c d e f g h i j k l m n o p q r s t u) do %>
        <img
            src={"images/B#{piece}.jpg"}
            id={"pieceB#{piece}"}
            onclick={"oc(\"B#{piece}\")"}
            onmouseover={"omin(\"B#{piece}\")"}
            onmouseout={"omout(\"B#{piece}\")"}
        />
        <% end %>
      </div>
    </div>
    <div id="yellowPosition">
      <div>
      <span id="YELLOWscore" class="score" >
        0
      </span>
        <span style={"BACKGROUND-COLOR: #{"YELLOW"};"}>
        playerFullname
        </span>
      </div>
      <div class="piece-set">
        <%= for piece <- ~w(a b c d e f g h i j k l m n o p q r s t u) do %>
        <img
            src={"images/B#{piece}.jpg"}
            id={"pieceY#{piece}"}
            onclick={"oc(\"Y#{piece}\")"}
            onmouseover={"omin(\"Y#{piece}\")"}
            onmouseout={"omout(\"Y#{piece}\")"}
        />
        <% end %>
      </div>
    </div>
    <div id="redPosition">
      <div>
      <span id="REDscore" class="score" >
        0
      </span>
        <span style={"BACKGROUND-COLOR: #{"RED"};"}>
        playerFullname
        </span>
      </div>
      <div class="piece-set">
        <%= for piece <- ~w(a b c d e f g h i j k l m n o p q r s t u) do %>
        <img
            src={"images/B#{piece}.jpg"}
            id={"pieceR#{piece}"}
            onclick={"oc(\"R#{piece}\")"}
            onmouseover={"omin(\"R#{piece}\")"}
            onmouseout={"omout(\"R#{piece}\")"}
        />
        <% end %>
      </div>
    </div>
    <div id="greenPosition">
      <div>
      <span id="GREENscore" class="score" >
        0
      </span>
        <span style={"BACKGROUND-COLOR: #{"GREEN"};"}>
        playerFullname
        </span>
      </div>
      <div class="piece-set">
        <%= for piece <- ~w(a b c d e f g h i j k l m n o p q r s t u) do %>
        <img
            src={"images/B#{piece}.jpg"}
            id={"pieceG#{piece}"}
            onclick={"oc(\"G#{piece}\")"}
            onmouseover={"omin(\"G#{piece}\")"}
            onmouseout={"omout(\"G#{piece}\")"}
        />
        <% end %>
      </div>
    </div>
  </div>
</div>

<hr />

<script
  type="text/javascript"
  src={Routes.static_path(@conn, "/assets/pentomino.js")}
>
  FindScrBrd();	// find the *named* board and the *named* piece stashes

  GoEnd();
</script>
<script type="text/javascript">
  InitSys()
  initPosition()
  // FindScrBrd();	// find the *named* board and the *named* piece stashes

  GoEnd();
</script>
